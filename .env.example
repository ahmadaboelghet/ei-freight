# EI Freight — Web Frontend (.env.local)
# Copy this file to .env.local and fill in your Firebase project values.
# NEVER commit .env.local to Git.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxx

# Set to "true" to route all Firebase calls to local emulators (firebase emulators:start)
VITE_USE_EMULATORS=true
